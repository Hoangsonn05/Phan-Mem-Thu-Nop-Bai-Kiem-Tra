<Project>
  <PropertyGroup>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ExamTransferSemanticVersion Condition="'$(ExamTransferSemanticVersion)' == ''">$(Version)</ExamTransferSemanticVersion>
    <ExamTransferBuildId Condition="'$(ExamTransferBuildId)' == ''">$(ExamTransferSemanticVersion)+development</ExamTransferBuildId>
    <ExamTransferGitCommit Condition="'$(ExamTransferGitCommit)' == ''">unknown</ExamTransferGitCommit>
    <ExamTransferWorkingTreeDirty Condition="'$(ExamTransferWorkingTreeDirty)' == ''">true</ExamTransferWorkingTreeDirty>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ExamTransferSemanticVersion" Value="$(ExamTransferSemanticVersion)" />
    <AssemblyMetadata Include="ExamTransferBuildId" Value="$(ExamTransferBuildId)" />
    <AssemblyMetadata Include="ExamTransferGitCommit" Value="$(ExamTransferGitCommit)" />
    <AssemblyMetadata Include="ExamTransferWorkingTreeDirty" Value="$(ExamTransferWorkingTreeDirty)" />
  </ItemGroup>
</Project>
