<UserControl x:Class="ExamTransfer.Desktop.Views.StudentExamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="32,24,32,20" MaxWidth="1280" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Timer Row -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border CornerRadius="4" Padding="8,4"
                            Background="{DynamicResource PrimarySoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Phòng: "
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="13" />
                            <TextBlock Text="{Binding RoomCode}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="13" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Subject}"
                               Style="{StaticResource BodyText}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource DisplayTitleText}"
                           FontSize="28" />
            </StackPanel>
            
            <!-- Compact Timer Card -->
            <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="20,12" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Background="{DynamicResource PrimarySoftBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="THỜI GIAN CÒN LẠI"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding TimeLeft}"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Kết nối: " Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding Connection}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Thí sinh: " Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding CandidateCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                        </StackPanel>
                        <ProgressBar Value="{Binding TimeProgress, Mode=OneWay}"
                                     Height="8"
                                     HorizontalAlignment="Stretch"
                                     Foreground="{DynamicResource PrimaryBrush}"
                                     Background="{DynamicResource OverlaySoftBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress + Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Steps -->
            <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Tiến trình kỳ thi" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16" />
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource SubtleCard}" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28"
                                                    Height="28"
                                                    CornerRadius="14"
                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Number}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="Đồng bộ"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,8" />
                        <Button Content="Tiếp tục bài thi"
                                Command="{Binding ContinueExamCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8" />
                        <Button Content="Kiểm tra kết nối"
                                Command="{Binding HeartbeatCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace -->
            <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="24,20,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Thư mục làm bài"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding WorkspaceFolder}"
                                       Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding BrowseWorkspaceCommand}"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource IconText}" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="Chọn thư mục" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenWorkspaceCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource IconText}" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="Mở" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshWorkspaceCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Margin="0,0,6,0" FontSize="14" />
                                    <TextBlock Text="Quét lại" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    
                    <TextBlock Grid.Row="1"
                               Text="Chỉ các file trong thư mục này được dùng làm nguồn chọn khi nộp bài."
                               Style="{StaticResource BodyText}"
                               Margin="24,0,24,16" />
                               
                    <DataGrid Grid.Row="2" ItemsSource="{Binding WorkspaceFiles}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN FILE" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding Size}" Width="120" />
                            <DataGridTextColumn Header="CHỈNH SỬA" Binding="{Binding Modified}" Width="160" />
                            <DataGridTextColumn Header="KIỂM TRA" Binding="{Binding Status}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
