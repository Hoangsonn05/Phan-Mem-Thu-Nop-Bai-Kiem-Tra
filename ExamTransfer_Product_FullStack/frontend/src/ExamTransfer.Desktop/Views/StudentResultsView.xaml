<UserControl x:Class="ExamTransfer.Desktop.Views.StudentResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Kết quả đã trả" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Chỉ hiển thị kết quả chính thức đã được giáo viên trả cho tài khoản hiện tại."
                               Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="5" />
                    <TextBlock Text="Đang tải kết quả authoritative..." Style="{StaticResource BodyText}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="Không thể tải kết quả" Style="{StaticResource SectionTitleText}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,14" />
                    <Button Content="Thử lại" Command="{Binding RetryCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="34"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource SectionTitleText}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN BÀI" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="LOẠI" Binding="{Binding TypeText}" Width="120" />
                            <DataGridTextColumn Header="ATTEMPT" Binding="{Binding AttemptText}" Width="105" />
                            <DataGridTextColumn Header="ĐIỂM" Binding="{Binding ScoreText}" Width="75" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="76" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding SelectedResult.Title}" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="{Binding SelectedResult.SourceText}" Style="{StaticResource CaptionText}"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ĐIỂM / TỐI ĐA" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding SelectedResult.ScoreText}" FontSize="24" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="TRẢ LÚC" Style="{StaticResource LabelText}" />
                                        <TextBlock Text="{Binding SelectedResult.ReturnedAtText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="NHẬN XÉT" Style="{StaticResource LabelText}" Margin="0,14,0,5" />
                                <TextBlock Text="{Binding SelectedResult.CommentText}" Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                Visibility="{Binding SelectedResult.IsQuiz, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Đúng / sai / bỏ trống" Style="{StaticResource SectionTitleText}" />
                                <DataGrid ItemsSource="{Binding SelectedResult.Questions}" Height="250" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" />
                                        <DataGridTextColumn Header="CÂU HỎI" Binding="{Binding Text}" Width="*" />
                                        <DataGridTextColumn Header="ĐÃ CHỌN" Binding="{Binding SelectedAnswerText}" Width="110" />
                                        <DataGridTextColumn Header="ĐÁP ÁN" Binding="{Binding CorrectAnswerText}" Width="110" />
                                        <DataGridTextColumn Header="KẾT QUẢ" Binding="{Binding OutcomeText}" Width="80" />
                                        <DataGridTextColumn Header="ĐIỂM" Binding="{Binding EarnedPoints}" Width="58" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                                Visibility="{Binding SelectedResult.HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Attachment của giáo viên" Style="{StaticResource SectionTitleText}" />
                                <DataGrid ItemsSource="{Binding SelectedResult.Attachments}"
                                          SelectedItem="{Binding SelectedAttachment}" Height="130" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TÊN TỆP" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding SizeBytes}" Width="95" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Tải attachment" Command="{Binding DownloadAttachmentCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
