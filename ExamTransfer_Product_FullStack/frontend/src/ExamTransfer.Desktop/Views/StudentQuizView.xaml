<UserControl x:Class="ExamTransfer.Desktop.Views.StudentQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,32,20" MaxWidth="1000" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Thi trắc nghiệm" Style="{StaticResource DisplayTitleText}"/>
                <TextBlock Text="Đáp án được lưu cục bộ trước, đồng bộ theo revision và chấm trên máy chủ." Style="{StaticResource BodyText}" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{Binding TimeLeft}" FontFamily="Consolas" FontWeight="Bold"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ClockStatus}" Style="{StaticResource CaptionText}"/>
                    <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Mở / làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="Đồng bộ" Command="{Binding SyncCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                <Button Command="{Binding FinalizeCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Height="46" Padding="20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Margin="0,0,8,0" FontSize="16"/>
                        <TextBlock Text="Chốt bài" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button Content="Về kỳ thi hiện tại"
                        Command="{Binding ExitQuizCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"/>
                <Button Content="Xem bài trắc nghiệm đã làm"
                        Command="{Binding ReviewCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
            <ItemsControl x:Name="ReviewQuestionsList" ItemsSource="{Binding Review.Questions}" Visibility="{Binding IsReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}">
                                    <Run Text="Câu "/><Run Text="{Binding Order, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding EarnedPoints, Mode=OneWay}"/>
                                    <Run Text="/"/><Run Text="{Binding Points, Mode=OneWay}"/><Run Text=" điểm"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold"
                                           FontSize="18" Margin="0,10,0,14"/>
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource SurfaceSubtleBrush}"
                                                    Margin="0,0,0,8" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding Selected}"
                                                              IsEnabled="False"/>
                                                    <TextBlock Grid.Column="1" Margin="12,0,0,0"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Correct, StringFormat=Đáp án đúng: {0}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="ActiveQuestionsList" ItemsSource="{Binding Questions}" Visibility="{Binding IsActiveAttemptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="24">
                            <StackPanel>
                                <Border Background="{DynamicResource InfoSoftBrush}" HorizontalAlignment="Left" Padding="12,4" CornerRadius="6" Margin="0,0,0,16">
                                    <TextBlock Foreground="{DynamicResource InfoBrush}" FontWeight="SemiBold" FontSize="12">
                                        <Run Text="Câu "/>
                                        <Run Text="{Binding Order, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Points, Mode=OneWay}"/>
                                        <Run Text=" điểm"/>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="18" LineHeight="26" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Background="{DynamicResource SurfaceSubtleBrush}" Margin="0,0,0,8">
                                                <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding DataContext.CanEditAnswers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Padding="12" FontSize="15" Margin="0" HorizontalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Result}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ReviewSummary}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ReviewComment}" Margin="12,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
