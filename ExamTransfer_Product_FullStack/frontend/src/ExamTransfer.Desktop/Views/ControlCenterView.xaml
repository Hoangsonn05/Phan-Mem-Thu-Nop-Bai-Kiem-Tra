<UserControl x:Class="ExamTransfer.Desktop.Views.ControlCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D7;"
                                   Style="{StaticResource IconText}"
                                   FontSize="20"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Kiểm soát phòng thi"
                                   Style="{StaticResource PageTitleText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Cấu hình policy, theo dõi khả năng thiết bị và xử lý tín hiệu vi phạm."
                               Style="{StaticResource BodyText}"
                               Margin="30,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              DisplayMemberPath="RoomCode"
                              Width="170" />
                    <Button Content="Tải trạng thái"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main content ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- Policy card -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE8D7;"
                                       Style="{StaticResource IconText}"
                                       FontSize="15"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="Policy hiện tại"
                                       Style="{StaticResource SectionTitleText}" />
                        </StackPanel>
                        <CheckBox Content="Yêu cầu toàn màn hình"
                                  IsChecked="{Binding Fullscreen}"
                                  Margin="0,0,0,10" />
                        <CheckBox Content="Cho phép thoát khẩn cấp bằng mã giáo viên"
                                  IsChecked="{Binding EmergencyExit}"
                                  Margin="0,0,0,16" />
                        <Separator />
                        <TextBlock Text="Quy tắc rời ứng dụng" Style="{StaticResource LabelText}" Margin="0,4,0,6" />
                        <TextBox Text="{Binding FocusRule}" />
                        <TextBlock Text="Clipboard" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding ClipboardRule}" />
                        <TextBlock Text="Tiến trình bị chặn" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding BlockedProcesses}" />
                        <TextBlock Text="Mạng" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                        <TextBox Text="{Binding NetworkRule}" />
                        <Separator />
                        <Button Content="Lưu policy"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0" />
                        <Button Content="Áp dụng cho phiên"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButton}"
                                MinHeight="42"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Device + Violations -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- Device card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16,18,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F4;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Trạng thái thiết bị"
                                           Style="{StaticResource SectionTitleText}" />
                            </StackPanel>
                        </Grid>
                        <Separator Grid.Row="0" Margin="0" VerticalAlignment="Bottom" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THIẾT BỊ" Binding="{Binding DeviceId}" Width="*" />
                                <DataGridTextColumn Header="KẾT NỐI" Binding="{Binding ConnectionState}" Width="90" />
                                <DataGridTextColumn Header="HEARTBEAT" Binding="{Binding HeartbeatAtUtc}" Width="140" />
                                <DataGridTextColumn Header="POLICY" Binding="{Binding PolicyState}" Width="90" />
                                <DataGridTextColumn Header="KHÓA" Binding="{Binding LockState}" Width="75" />
                                <DataGridTextColumn Header="AGENT" Binding="{Binding AgentVersion}" Width="75" />
                                <DataGridTextColumn Header="COMMAND" Binding="{Binding LastCommandStatus}" Width="90" />
                                <DataGridTextColumn Header="LỖI" Binding="{Binding LastCommandError}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Violations card -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="{DynamicResource WarningSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="12,12,0,0"
                                Padding="18,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Vi phạm và xử lý"
                                           Style="{StaticResource SectionTitleText}"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Violations}"
                                  SelectedItem="{Binding SelectedViolation}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding OccurredAtUtc}" Width="150" />
                                <DataGridTextColumn Header="LOẠI" Binding="{Binding Type}" Width="*" />
                                <DataGridTextColumn Header="MỨC" Binding="{Binding Severity}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2"
                                Background="{DynamicResource SurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12"
                                Padding="18,12">
                            <Button Content="Đánh dấu đã xử lý"
                                    Command="{Binding AcknowledgeCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="42" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
