<UserControl x:Class="ExamTransfer.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="-2" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="DashboardMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="38" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid MaxWidth="1400" Margin="32,28,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page title and refresh -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tổng quan hệ thống"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   LineHeight="36" />
                        <TextBlock Text="Theo dõi lớp học, kỳ thi và các cảnh báo cần xử lý trong một nơi."
                                   Style="{StaticResource BodyText}"
                                   FontSize="15"
                                   Margin="0,4,0,0"
                                   MaxWidth="620"
                                   HorizontalAlignment="Left" />
                        <Border Width="60" Height="3" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Background="{DynamicResource PrimaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Top"
                            Margin="20,2,0,0"
                            MinHeight="40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       Style="{StaticResource IconText}"
                                       FontSize="16"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Làm mới"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Statistics -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Metrics}"
                              Margin="0,0,0,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,16,0" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="3">
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.AlternationCount>4</ItemsControl.AlternationCount>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCard}"
                                    Padding="20"
                                    MinHeight="190">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource LabelText}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="12"
                                                Background="{Binding Tone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding Glyph}"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="20"
                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Value}"
                                               Style="{StaticResource DashboardMetricValue}"
                                               Margin="0,14,0,0" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Subtitle}"
                                               Style="{StaticResource BodyText}"
                                               FontSize="13"
                                               Margin="0,1,0,0" />

                                    <Border Grid.Row="4"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,14,0,0"
                                            Padding="0,9,0,0">
                                        <TextBlock Text="{Binding Trend}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontSize="11"
                                                   FontStyle="Italic"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Session and alerts -->
                <Grid Grid.Row="2" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Active session -->
                    <Border Grid.Column="0" Padding="0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DashboardCard}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Padding="24,21" CornerRadius="16,16,0,0"
                                    Background="{DynamicResource PrimaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PHIÊN THI GẦN ĐÂY"
                                                   Foreground="{DynamicResource OnPrimaryMutedBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding ActiveSession.Title}"
                                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Border Padding="9,4"
                                                     CornerRadius="8"
                                                     Background="{DynamicResource OverlaySoftBrush}">
                                                <TextBlock Text="{Binding ActiveSession.RoomCode}"
                                                            Foreground="{DynamicResource OnPrimaryBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding ActiveSession.Status}"
                                                       Foreground="{DynamicResource OnPrimaryMutedBrush}"
                                                       FontSize="12"
                                                       Margin="10,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="24,0,0,0">
                                        <TextBlock Text="THỜI GIAN CÒN LẠI"
                                                   Foreground="{DynamicResource OnPrimaryMutedBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding ActiveSession.TimeLeft}"
                                                   Foreground="{DynamicResource OnPrimaryBrush}"
                                                   FontSize="29"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="24,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Thiết bị đang kết nối"
                                                   Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="{Binding ActiveSession.Connected}"
                                                   HorizontalAlignment="Right"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                   FontWeight="Bold" />
                                    </Grid>
                                    <ProgressBar Value="{Binding ActiveSession.ConnectedPercent, Mode=OneWay}"
                                                 Height="7"
                                                 Margin="0,11,0,0"
                                                  Foreground="{DynamicResource PrimaryBrush}"
                                                  Background="{DynamicResource PrimarySoftBrush}" />
                                    <TextBlock Text="{Binding ActiveSession.Total, StringFormat='Tổng {0} thiết bị'}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,7,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Bài đã nộp"
                                                   Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="{Binding ActiveSession.Submitted}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Bold" />
                                    </Grid>
                                    <ProgressBar Value="{Binding ActiveSession.SubmittedPercent, Mode=OneWay}"
                                                 Height="7"
                                                 Margin="0,11,0,0"
                                                 Foreground="{DynamicResource SuccessBrush}"
                                                 Background="{DynamicResource SuccessSoftBrush}" />
                                    <TextBlock Text="Được máy chủ xác nhận"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="24,14">
                                <Grid>
                                    <TextBlock Text="Theo dõi realtime, upload và cảnh báo thiết bị"
                                               Style="{StaticResource CaptionText}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Mở giám sát"
                                            IsEnabled="False"
                                            ToolTip="Chưa có command điều hướng trong DashboardViewModel"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PrimaryButton}"
                                            MinHeight="36" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Empty session -->
                    <Border Grid.Column="0"
                            Padding="24"
                            MinHeight="260">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DashboardCard}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveSession}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="28">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        MaxWidth="390">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="16"
                                         Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock Text="&#xE9D2;"
                                               Style="{StaticResource IconText}"
                                               FontSize="25"
                                                Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                                <TextBlock Text="Chưa có phiên thi gần đây"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="Phiên thi sẽ xuất hiện tại đây khi máy chủ trả về dữ liệu."
                                           Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Alerts -->
                    <Border Grid.Column="2"
                            Style="{StaticResource DashboardCard}"
                            Padding="0"
                            MinHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="20,18,20,14">
                                <TextBlock Text="Cảnh báo cần chú ý"
                                           Style="{StaticResource DashboardSectionTitle}" />
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                         Background="{DynamicResource DangerSoftBrush}"
                                         BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1"
                                        Padding="6,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Alerts.Count}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text=" cảnh báo"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Alerts}"
                                                  Margin="12,0,12,14">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="13"
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding Tone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}"
                                                        Background="{Binding Tone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="34"
                                                                Height="34"
                                                                CornerRadius="10"
                                                                Background="{DynamicResource SurfaceBrush}">
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       Style="{StaticResource IconText}"
                                                                       FontSize="15"
                                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource CardTitleText}"
                                                                       FontSize="13"
                                                                       Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       Style="{StaticResource CaptionText}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE73E;"
                                               Style="{StaticResource IconText}"
                                               FontSize="25"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="Không có cảnh báo"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Recent activity -->
                <Border Grid.Row="3"
                        Style="{StaticResource DashboardCard}"
                        Padding="0"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="20,18,20,14">
                            <TextBlock Text="Hoạt động gần đây"
                                       Style="{StaticResource DashboardSectionTitle}" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="12,10"
                                    MaxWidth="440">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Activities}"
                                          Margin="20,0,20,18">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActivities}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}"
                                                       Style="{StaticResource CaptionText}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas" />
                                            <Grid Grid.Column="1">
                                                <Rectangle Width="2"
                                                           Fill="{DynamicResource BorderBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Stretch" />
                                                <Border Width="30"
                                                        Height="30"
                                                        CornerRadius="15"
                                                        Background="{Binding Tone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}">
                                                    <TextBlock Text="{Binding Glyph}"
                                                               Style="{StaticResource IconText}"
                                                               FontSize="13"
                                                               Foreground="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="2"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource CardTitleText}"
                                                           FontSize="13" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource CaptionText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="20,4,20,24"
                                        HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActivities}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE823;"
                                           Style="{StaticResource IconText}"
                                           FontSize="28"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="Chưa có hoạt động"
                                           Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
