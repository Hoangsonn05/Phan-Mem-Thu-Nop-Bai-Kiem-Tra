<UserControl x:Class="ExamTransfer.Desktop.Views.StudentHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="HomeCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeFieldStyle"
               TargetType="Border"
               BasedOn="{StaticResource SubtleCard}">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="92" />
        </Style>

        <Style x:Key="HomeFieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="HomeFieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HomeIconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="HomeSessionRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="28,24,28,24" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Student identity hero -->
            <Border Grid.Row="0"
                    CornerRadius="16"
                    Background="{DynamicResource PrimaryBrush}"
                    ClipToBounds="True">
                <Grid>
                    <Grid Margin="28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="76"
                                Height="76"
                                CornerRadius="22"
                                Background="{DynamicResource HeroAvatarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HeroAvatarForegroundBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="20,0,24,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnPrimaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Hồ sơ sinh viên đã được xác thực từ hệ thống."
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource OnPrimaryMutedBrush}" />

                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                <Border Padding="10,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource PrimarySoftBrush}"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding RoleLabel}"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="8,0,0,0"
                                        Padding="10,5"
                                        CornerRadius="8"
                                        Background="{DynamicResource PrimarySoftBrush}"
                                        BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                        <TextBlock Text="{Binding StudentCode, StringFormat=Mã sinh viên: {0}}"
                                                   Margin="6,0,0,0"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Padding="11,6"
                                CornerRadius="8"
                                Background="{Binding AccountStatusTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{Binding AccountStatusTone, Converter={StaticResource ToneBrushConverter}}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding AccountStatus}"
                                           Margin="7,0,0,0"
                                           Foreground="{Binding AccountStatusTone, Converter={StaticResource ToneBrushConverter}}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Account detail cards -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.12*" MinWidth="430" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.88*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <!-- Student information -->
                <Border Style="{StaticResource HomeCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HomeIconTileStyle}"
                                    Background="{DynamicResource InfoSoftBrush}">
                                <TextBlock Text="&#xE77B;"
                                           Style="{StaticResource IconText}"
                                           FontSize="16"
                                           Foreground="{DynamicResource InfoBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Thông tin sinh viên"
                                           Style="{StaticResource SectionTitleText}"
                                           FontSize="16" />
                                <TextBlock Text="Dữ liệu được lấy từ hồ sơ tài khoản trên máy chủ và không chỉnh sửa trực tiếp tại đây."
                                           Style="{StaticResource BodyText}"
                                           FontSize="12"
                                           LineHeight="18"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2" Margin="0,18,0,0">
                            <Border Style="{StaticResource HomeFieldStyle}" Margin="0,0,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HomeIconTileStyle}"
                                            Width="32" Height="32"
                                            Background="{DynamicResource InfoSoftBrush}">
                                        <TextBlock Text="&#xE77B;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource InfoBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource HomeFieldLabelStyle}" />
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HomeFieldValueStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource HomeFieldStyle}" Margin="6,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HomeIconTileStyle}"
                                            Width="32" Height="32"
                                            Background="{DynamicResource InfoSoftBrush}">
                                        <TextBlock Text="&#xE8D7;"
                                                   Style="{StaticResource IconText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource InfoBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="MÃ SINH VIÊN" Style="{StaticResource HomeFieldLabelStyle}" />
                                        <TextBlock Text="{Binding StudentCode}"
                                                   Style="{StaticResource HomeFieldValueStyle}"
                                                   FontFamily="Consolas" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource HomeFieldStyle}" Margin="0,6,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HomeIconTileStyle}"
                                            Width="32" Height="32"
                                            Background="{DynamicResource SuccessSoftBrush}">
                                        <TextBlock Text="&#xE787;"
                                            Style="{StaticResource IconText}"
                                            FontSize="13"
                                            Foreground="{DynamicResource SuccessBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="NGÀY SINH" Style="{StaticResource HomeFieldLabelStyle}" />
                                        <TextBlock Text="{Binding DateOfBirthText}" Style="{StaticResource HomeFieldValueStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource HomeFieldStyle}" Margin="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource HomeIconTileStyle}"
                                            Width="32" Height="32"
                                            Background="{DynamicResource WarningSoftBrush}">
                                        <TextBlock Text="&#xEA18;"
                                            Style="{StaticResource IconText}"
                                            FontSize="13"
                                            Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                        <TextBlock Text="VAI TRÒ" Style="{StaticResource HomeFieldLabelStyle}" />
                                        <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource HomeFieldValueStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Login session -->
                <Border Grid.Column="2" Style="{StaticResource HomeCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource HomeIconTileStyle}"
                                    Background="{DynamicResource PrimarySoftBrush}">
                                <TextBlock Text="&#xE72E;"
                                           Style="{StaticResource IconText}"
                                           FontSize="16"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Phiên đăng nhập"
                                           Style="{StaticResource SectionTitleText}"
                                           FontSize="16" />
                                <TextBlock Text="Thông tin phiên đang hoạt động trên thiết bị này"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource HomeSessionRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE77B;"
                                           Style="{StaticResource IconText}"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="TÀI KHOẢN" Style="{StaticResource HomeFieldLabelStyle}" />
                                    <TextBlock Text="{Binding Username}"
                                               Style="{StaticResource HomeFieldValueStyle}"
                                               FontFamily="Consolas"
                                               FontSize="14" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HomeSessionRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE950;"
                                           Style="{StaticResource IconText}"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="DEVICE ID" Style="{StaticResource HomeFieldLabelStyle}" />
                                    <TextBlock Text="{Binding DeviceId}"
                                               ToolTip="{Binding DeviceId}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource HomeSessionRowStyle}"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE823;"
                                           Style="{StaticResource IconText}"
                                           FontSize="14"
                                           Foreground="{DynamicResource SuccessBrush}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="PHIÊN HẾT HẠN" Style="{StaticResource HomeFieldLabelStyle}" />
                                    <TextBlock Text="{Binding SessionExpiresAt}"
                                               Style="{StaticResource HomeFieldValueStyle}"
                                               FontSize="14" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Padding="11,6"
                                CornerRadius="8"
                                Background="{Binding PasswordTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;"
                                           Style="{StaticResource IconText}"
                                           FontSize="12"
                                           Foreground="{Binding PasswordTone, Converter={StaticResource ToneBrushConverter}}" />
                                <TextBlock Text="{Binding PasswordStatus}"
                                           Margin="7,0,0,0"
                                           Foreground="{Binding PasswordTone, Converter={StaticResource ToneBrushConverter}}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Temporary-password warning; driven only by the existing property. -->
            <Border Grid.Row="2" Margin="0,16,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SubtleCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MustChangePassword}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1">
                        <TextBlock Text="&#xE7BA;"
                                   Style="{StaticResource IconText}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="17" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tài khoản đang sử dụng mật khẩu tạm"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="Trong giai đoạn kiểm thử, bạn vẫn có thể dùng ứng dụng. Khi chức năng đổi mật khẩu được mở, hãy thay mật khẩu chung bằng mật khẩu cá nhân."
                                   Style="{StaticResource BodyText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
