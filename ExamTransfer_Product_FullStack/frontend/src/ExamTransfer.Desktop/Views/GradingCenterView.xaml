<UserControl x:Class="ExamTransfer.Desktop.Views.GradingCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Chấm bài tự luận và tệp" Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="Lưu bản chấm và trả kết quả là hai thao tác độc lập."
                               Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách bài cần chấm" Style="{StaticResource SectionTitleText}"
                               Margin="18,16,18,12" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Queue}"
                              SelectedItem="{Binding SelectedWorkItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ HS" Binding="{Binding StudentCode}" Width="82" />
                            <DataGridTextColumn Header="HỌC SINH" Binding="{Binding StudentName}" Width="*" />
                            <DataGridTextColumn Header="LẦN" Binding="{Binding AttemptNumber}" Width="48" />
                            <DataGridTextColumn Header="NỘP LÚC" Binding="{Binding SubmittedAtUtc, StringFormat={}{0:dd/MM HH:mm}}" Width="100" />
                            <DataGridCheckBoxColumn Header="TRỄ" Binding="{Binding IsLate}" Width="44" IsReadOnly="True" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Chi tiết bài nộp" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Học sinh" Style="{StaticResource LabelText}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail.StudentName}" />
                                <TextBlock Grid.Row="1" Text="Mã / lần nộp" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,7,0,0">
                                    <Run Text="{Binding Detail.StudentCode}" /><Run Text=" · Lần " /><Run Text="{Binding Detail.AttemptNumber}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Text="Thời gian" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Detail.SubmittedAtUtc, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="3" Text="Trạng thái" Style="{StaticResource LabelText}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Detail.StatusText}" Margin="0,7,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding IsFileSubmission, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Tệp bài làm" Style="{StaticResource SectionTitleText}" />
                            <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                                      Height="145" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TÊN TỆP" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="KÍCH THƯỚC" Binding="{Binding SizeBytes}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Tải tệp" Command="{Binding DownloadFileCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="Mở tệp đã tải" Command="{Binding OpenLocalFileCommand}"
                                        Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Điểm và nhận xét" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ĐIỂM" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding Editor.ScoreText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="THANG ĐIỂM" Style="{StaticResource LabelText}" />
                                    <TextBox Text="{Binding Editor.MaxScore}" IsReadOnly="True"
                                             FontSize="22" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Editor.ValidationMessage}"
                                       Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="NHẬN XÉT" Style="{StaticResource LabelText}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding Editor.Comment, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Content="Lưu bản chấm" Command="{Binding SaveGradeCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" MinHeight="42" />
                            <Button Content="Trả kết quả" Command="{Binding ReturnGradeCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" />
                            <Button Content="Mở lại để chỉnh sửa" Command="{Binding ReopenGradeCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,5,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"
                            Visibility="{Binding IsQuizAttempt, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Chi tiết câu trắc nghiệm" Style="{StaticResource SectionTitleText}" />
                            <DataGrid ItemsSource="{Binding QuizQuestions}" Height="220" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="42" />
                                    <DataGridTextColumn Header="CÂU HỎI" Binding="{Binding Text}" Width="*" />
                                    <DataGridTextColumn Header="ĐIỂM" Binding="{Binding EarnedPoints}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="4" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
