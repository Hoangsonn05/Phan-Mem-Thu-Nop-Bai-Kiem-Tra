<UserControl x:Class="ExamTransfer.Desktop.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsTabStop="False"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Width="380"
            Margin="20"
            Padding="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{Binding ToneKey, Converter={StaticResource ToneBrushConverter}}"
            BorderThickness="1"
            CornerRadius="10"
            Focusable="False">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{Binding ToneKey, Converter={StaticResource ToneBrushConverter}}"
                    CornerRadius="9,0,0,9" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ToneGlyph}"
                       Style="{StaticResource IconText}"
                       Foreground="{Binding ToneKey, Converter={StaticResource ToneBrushConverter}}"
                       FontSize="17"
                       Margin="14,16,10,0"
                       VerticalAlignment="Top"
                       Focusable="False" />
            <StackPanel Grid.Column="2" Margin="0,13,8,13" Focusable="False">
                <TextBlock Text="{Binding Current.Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Focusable="False" />
                <TextBlock Text="{Binding Current.Message}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Focusable="False" />
                <TextBlock Text="{Binding Current.OccurredAtUtc, StringFormat={}{0:HH:mm:ss}}"
                           Margin="0,6,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Focusable="False" />
            </StackPanel>
            <Button Grid.Column="3"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Đóng thông báo"
                    AutomationProperties.Name="Đóng thông báo"
                    Focusable="False"
                    IsTabStop="False"
                    MinWidth="30"
                    MinHeight="30"
                    Margin="0,7,7,0"
                    VerticalAlignment="Top">
                <TextBlock Text="&#xE711;"
                           Style="{StaticResource IconText}"
                           FontSize="12"
                           Focusable="False" />
            </Button>
        </Grid>
    </Border>
</UserControl>
