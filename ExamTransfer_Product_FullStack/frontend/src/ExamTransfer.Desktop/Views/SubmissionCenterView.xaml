<UserControl x:Class="ExamTransfer.Desktop.Views.SubmissionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <UserControl.Resources>
        <Style x:Key="SubmissionGridColumnHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubmissionGridCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;"
                                   Style="{StaticResource IconText}"
                                   FontSize="20"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Trung tâm thu bài"
                                   Style="{StaticResource PageTitleText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Theo dõi attempt, trạng thái xác minh, biên nhận và quyền nộp lại của từng học sinh."
                               Style="{StaticResource BodyText}"
                               Margin="30,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Sessions}"
                              SelectedItem="{Binding SelectedSession}"
                              DisplayMemberPath="Title"
                              Width="260" />
                    <Button Content="Tải danh sách"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource PrimaryButton}"
                            MinHeight="42"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ KPI strip ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SuccessSoftBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="0,0,0,3"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="ĐÃ NỘP" Style="{StaticResource LabelText}"
                               Foreground="{DynamicResource SuccessOnSoftBrush}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SubmittedCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SubtleCard}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="CHƯA NỘP" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NotSubmittedCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="0,0,0,3"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="NỘP MUỘN" Style="{StaticResource LabelText}"
                               Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x23F1;" FontFamily="Segoe UI Symbol" FontSize="17"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding LateCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="6"
                    Background="{DynamicResource DangerSoftBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="0,0,0,3"
                    CornerRadius="8"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding IssueKpiLabel}" Style="{StaticResource LabelText}"
                               Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA39;" Style="{StaticResource IconText}" FontSize="16"
                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding IssueCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Main content ═══ -->
        <Grid Grid.Row="4">
            <Grid x:Name="FileSubmissionLayout"
                  Visibility="{Binding IsFileSubmissionSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.75*" MinWidth="300" MaxWidth="340" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7B8;"
                                           Style="{StaticResource IconText}"
                                           FontSize="15"
                                           Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Bài nộp theo phiên"
                                           Style="{StaticResource SectionTitleText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox Content="Chọn tất cả"
                                          IsChecked="{Binding AllVisibleSelected, Mode=OneWay}"
                                          Command="{Binding SelectAllCommand}"
                                          VerticalAlignment="Center" />
                                <Button Content="Bỏ chọn"
                                        Command="{Binding ClearSelectionCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinHeight="32"
                                        Margin="12,0,0,0" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource BodyText}">
                                    <Run Text="Đã chọn " />
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" bài" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <Separator Grid.Row="0" Margin="0" VerticalAlignment="Bottom" />
                        <DataGrid x:Name="FileSubmissionGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Submissions}"
                                  SelectedItem="{Binding SelectedSubmission}"
                                  AutoGenerateColumns="False"
                                  ColumnHeaderStyle="{StaticResource SubmissionGridColumnHeaderStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="CHỌN" Width="60" MinWidth="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanSelect}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="MÃ" Binding="{Binding StudentCode}" Width="95" MinWidth="90"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding StudentName}" Width="*" MinWidth="170"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="LẦN" Binding="{Binding AttemptNumber}" Width="60" MinWidth="55"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="120" MinWidth="110"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridCheckBoxColumn Header="MUỘN"
                                                        Binding="{Binding IsLate, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="65"
                                                        MinWidth="60" />
                                <DataGridTextColumn Header="BIÊN NHẬN" Binding="{Binding ReceiptCode}" Width="145" MinWidth="125"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1"
                                   Text="Chưa có bài đã nộp trong phiên này."
                                   Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoSubmissions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="FileActionPanel"
                              Grid.Column="2"
                              MinWidth="300"
                              MaxWidth="340"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="&#xE90F;"
                                               Style="{StaticResource IconText}"
                                               FontSize="15"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Xử lý bài nộp"
                                               Style="{StaticResource SectionTitleText}" />
                                </StackPanel>
                                <TextBlock Text="Lý do" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Reason}" Height="80" AcceptsReturn="True" />
                                <Separator Margin="0,14" />
                                <Button Content="Tải bài đã chọn"
                                        Command="{Binding DownloadSelectedCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,8" />
                                <Button Content="Sao chép mã biên nhận"
                                        Command="{Binding CopyReceiptCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,8" />
                                <Button Content="Cho nộp lại"
                                        Command="{Binding ResubmitCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinHeight="42" />
                                <Border Background="{DynamicResource DangerSoftBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,16,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE7BA;"
                                                       Style="{StaticResource IconText}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="Hành động không thể hoàn tác"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                        <Button Content="Từ chối attempt"
                                                Command="{Binding RejectCommand}"
                                                Style="{StaticResource DangerButton}"
                                                MinHeight="42" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtleCard}" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           Style="{StaticResource IconText}"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Text="Mọi attempt được lưu append-only. Từ chối không xóa file cũ; nộp lại sẽ tạo attempt mới."
                                           Style="{StaticResource BodyText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="QuizSubmissionLayout"
                  Visibility="{Binding IsMultipleChoiceSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16,18,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7B8;"
                                               Style="{StaticResource IconText}"
                                               FontSize="15"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Kết quả trắc nghiệm theo phiên"
                                               Style="{StaticResource SectionTitleText}" />
                                </StackPanel>
                                <TextBlock Text="Thao tác tải tệp, từ chối và cho nộp lại chỉ áp dụng bài nộp tệp."
                                           Style="{StaticResource BodyText}"
                                           Margin="23,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Separator Grid.Row="0" Margin="0" VerticalAlignment="Bottom" />
                        <DataGrid x:Name="QuizSubmissionGrid"
                                  Grid.Row="1"
                                  ItemsSource="{Binding Submissions}"
                                  SelectedItem="{Binding SelectedSubmission}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ColumnHeaderStyle="{StaticResource SubmissionGridColumnHeaderStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MÃ" Binding="{Binding StudentCode}" Width="100" MinWidth="90"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding StudentName}" Width="*" MinWidth="180"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding StatusText}" Width="115" MinWidth="105"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="CHẤM" Binding="{Binding GradingStatusText}" Width="100" MinWidth="90"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTextColumn Header="ĐIỂM" Binding="{Binding ScoreSummaryText}" Width="100" MinWidth="90"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridTemplateColumn Header="BẮT ĐẦU" Width="140" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartedAtText}"
                                                       ToolTip="{Binding StartedAtText}"
                                                       Style="{StaticResource SubmissionGridCellTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CHỐT BÀI" Width="140" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FinalizedAtText}"
                                                       ToolTip="{Binding FinalizedAtText}"
                                                       Style="{StaticResource SubmissionGridCellTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="THỜI GIAN" Binding="{Binding DurationText}" Width="95" MinWidth="90"
                                                    ElementStyle="{StaticResource SubmissionGridCellTextStyle}" />
                                <DataGridCheckBoxColumn Header="MUỘN"
                                                        Binding="{Binding IsLate, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="65"
                                                        MinWidth="60" />
                                <DataGridTemplateColumn Header="DỮ LIỆU" Width="190" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DataIssue}"
                                                       ToolTip="{Binding DataIssue}"
                                                       Style="{StaticResource SubmissionGridCellTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="1"
                                   Text="Chưa có attempt trắc nghiệm đã chốt trong phiên này."
                                   Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoSubmissions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="6" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
