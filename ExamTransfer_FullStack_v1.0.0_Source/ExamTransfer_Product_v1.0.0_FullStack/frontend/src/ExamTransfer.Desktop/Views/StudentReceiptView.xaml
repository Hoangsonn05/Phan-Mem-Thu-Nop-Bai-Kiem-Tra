<UserControl x:Class="ExamTransfer.Desktop.Views.StudentReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="32,24,32,20" MaxWidth="900" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="Biên nhận bài nộp"
                       Style="{StaticResource DisplayTitleText}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Mã xác nhận, thời gian máy chủ nhận bài, chữ ký và hash file."
                       Style="{StaticResource BodyText}"
                       Margin="0,8,0,0"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Dynamic Content -->
        <Grid Grid.Row="2">
            
            <!-- Empty State -->
            <Border Padding="60,80">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Receipt}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource SurfaceSubtleBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Chưa có biên nhận" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,24,0,8" />
                    <TextBlock Text="Bài làm chưa được nộp hoặc máy chủ chưa phản hồi. Vui lòng kiểm tra lại." Style="{StaticResource BodyText}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,24,0,0" Height="40" Padding="20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                            <TextBlock Text="Tải lại trạng thái" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Receipt Card (Success State) -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Receipt}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Receipt Layout -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Top section: Icon and Code -->
                    <Border Grid.Row="0" Padding="40,40,40,24" Background="{DynamicResource PrimarySoftBrush}">
                        <StackPanel>
                            <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="28" Foreground="{DynamicResource OnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="MÁY CHỦ ĐÃ XÁC NHẬN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Receipt.ReceiptCode}" FontSize="42" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                    
                    <!-- Dashed separator -->
                    <Line Grid.Row="1" X1="0" Y1="0" X2="1000" Y2="0" Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2" StrokeDashArray="4 4" VerticalAlignment="Center" />
                    
                    <!-- Middle section: Info -->
                    <Grid Grid.Row="2" Margin="40,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Thời gian nhận (UTC)" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding Receipt.ServerReceivedAtUtc}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Trạng thái" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                <TextBlock Text="Hợp lệ" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Chữ ký" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                <TextBlock Text="Đã xác thực" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="CHI TIẾT FILE NỘP" Style="{StaticResource LabelText}" Margin="0,0,0,12" />
                            <DataGrid ItemsSource="{Binding Receipt.Files}"
                                      Height="160"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      Background="{DynamicResource SurfaceSubtleBrush}"
                                      AutoGenerateColumns="False" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      RowHeight="40" CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="12,8" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FILE" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeBytes}" Width="100" />
                                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="240" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Bottom section: Actions -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceSubtleBrush}" Padding="40,24" CornerRadius="0,0,16,16" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Height="44" Padding="24,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                                    <TextBlock Text="Tải lại" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Height="44" Padding="28,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Margin="0,0,8,0" FontSize="16" />
                                    <TextBlock Text="Sao chép mã" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Height="44" Padding="24,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                                    <TextBlock Text="Lưu JSON" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>