<UserControl x:Class="ExamTransfer.Desktop.Views.ExamManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Bài kiểm tra và file đề"
                           Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Soạn bài kiểm tra, thiết lập quy định file, phát hành và quản lý phiên bản đề."
                           Style="{StaticResource BodyText}"
                           Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="Lưu thay đổi"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0" />
                <Button Content="Tạo bài kiểm tra"
                        Command="{Binding CreateCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Exam list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách bài kiểm tra"
                               Style="{StaticResource SectionTitleText}"
                               Margin="18,16,18,10" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Exams}"
                              SelectedItem="{Binding SelectedExam}"
                              SelectionChanged="OnExamSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIÊU ĐỀ" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="MÔN" Binding="{Binding Subject}" Width="110" />
                            <DataGridTextColumn Header="PHÚT" Binding="{Binding DurationMinutes}" Width="65" />
                            <DataGridTextColumn Header="FILE" Binding="{Binding FileCount}" Width="55" />
                            <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="18,12,18,16">
                        <TextBlock Text="{Binding PublishHint}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Phát hành"
                                    Command="{Binding PublishCommand}"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button Content="Nhân bản"
                                    Command="{Binding CloneCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0" />
                            <Button Content="Lưu trữ"
                                    Command="{Binding ArchiveCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Exam info -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Thông tin và quy định"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Lớp học"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding Classes}"
                                      SelectedItem="{Binding SelectedClass}"
                                      DisplayMemberPath="Name" />
                            <TextBlock Text="Tiêu đề *"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6" />
                            <TextBox Text="{Binding Title}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Môn học *" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Subject}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Thời lượng" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Duration}"
                                             IsEnabled="{Binding IsPolicyEditable}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mô tả / hướng dẫn"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6" />
                            <TextBox Text="{Binding Description}"
                                     Height="70"
                                     AcceptsReturn="True" />
                            <TextBlock Text="Phần mở rộng cho phép"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,12,0,6" />
                            <TextBox Text="{Binding AllowedExtensions}" />
                        </StackPanel>
                    </Border>

                    <!-- Delivery type and policy -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Loại bài kiểm tra"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Loại bài và chính sách bị khóa sau khi phát hành hoặc đã có phiên thi."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,5,0,12"
                                       TextWrapping="Wrap" />
                            <RadioButton Content="Tự luận / nộp file"
                                         IsChecked="{Binding IsFileSubmission, Mode=TwoWay}"
                                         IsEnabled="{Binding IsPolicyEditable}"
                                         GroupName="DeliveryType"
                                         Margin="0,0,0,5" />
                            <TextBlock Text="Học sinh nhận file đề và nộp bài theo quy tắc file hiện có."
                                       Style="{StaticResource CaptionText}"
                                       Margin="24,0,0,12"
                                       TextWrapping="Wrap" />
                            <RadioButton Content="Trắc nghiệm"
                                         IsChecked="{Binding IsMultipleChoice, Mode=TwoWay}"
                                         IsEnabled="{Binding IsPolicyEditable}"
                                         GroupName="DeliveryType"
                                         Margin="0,0,0,5" />
                            <TextBlock Text="Nguồn Word/PDF được preview rồi commit; file nguồn chỉ giáo viên được đọc."
                                       Style="{StaticResource CaptionText}"
                                       Margin="24,0,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- File list -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,14,0,0"
                            Padding="0"
                            Visibility="{Binding IsFileSubmission, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="18,16,18,10">
                                <TextBlock Text="File đề tự luận và phiên bản"
                                       Style="{StaticResource SectionTitleText}"
                                       />
                                <TextBlock Text="Có thể lưu nháp khi chưa có file, nhưng phải có file đề hoàn tất trước khi phát hành."
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap" />
                                <CheckBox Content="Áp dụng quy trình giám sát"
                                          IsChecked="{Binding UseSupervision}"
                                          IsEnabled="{Binding IsPolicyEditable}"
                                          Margin="0,10,0,0" />
                                <Button Content="Tải file đề cho học sinh"
                                        Command="{Binding UploadCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="TÊN FILE" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeBytes}" Width="100" />
                                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="18,10,18,14">
                                <Button Content="Tải xuống"
                                        Command="{Binding DownloadFileCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="Xóa file"
                                        Command="{Binding DeleteFileCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quiz source preview and commit -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,14,0,0"
                            Visibility="{Binding IsMultipleChoice, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Nguồn và câu hỏi trắc nghiệm"
                                       Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Giám sát: Bắt buộc — Quy trình giám sát chuẩn"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,8,0,0" />
                            <CheckBox Content="Hiện điểm sau khi nộp"
                                      IsChecked="{Binding ShowScoreAfterSubmission}"
                                      IsEnabled="{Binding IsPolicyEditable}"
                                      Margin="0,10,0,0" />
                            <TextBlock Text="Nếu tắt, API học sinh không nhận điểm; đáp án đúng không được gửi xuống client."
                                       Style="{StaticResource CaptionText}"
                                       Margin="24,4,0,12"
                                       TextWrapping="Wrap" />
                            <Button Content="Chọn Word/PDF và xem trước"
                                    Command="{Binding ImportQuizCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding QuizImport.Summary}"
                                       Style="{StaticResource BodyText}"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding QuizImport.ReplaceNotice}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding QuizImport.Errors}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding QuizImport.Warnings}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DataGrid ItemsSource="{Binding QuizImport.Questions}"
                                      Height="180"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45" />
                                    <DataGridTextColumn Header="CÂU HỎI" Binding="{Binding Text}" Width="*" />
                                    <DataGridTextColumn Header="ĐIỂM" Binding="{Binding Points}" Width="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Commit bộ câu hỏi"
                                    Command="{Binding CommitQuizCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Style="{StaticResource StatusPill}"
                HorizontalAlignment="Left"
                Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}">
            <TextBlock Text="{Binding Status}"
                       Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                       FontSize="12" />
        </Border>
    </Grid>
</UserControl>
