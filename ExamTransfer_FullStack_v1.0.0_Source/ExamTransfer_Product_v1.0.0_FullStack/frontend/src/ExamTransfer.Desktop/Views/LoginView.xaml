<UserControl x:Class="ExamTransfer.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True"
             FocusManager.FocusedElement="{Binding ElementName=AccountInput}">

    <UserControl.Resources>
        <!-- Login-only design tokens. These resources do not affect other screens. -->
        <SolidColorBrush x:Key="LoginNavyBrush" Color="#0B1F33" />
        <SolidColorBrush x:Key="LoginTealBrush" Color="#0F766E" />
        <SolidColorBrush x:Key="LoginMintBrush" Color="#5EEAD4" />
        <SolidColorBrush x:Key="LoginHeroTextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="LoginHeroMutedBrush" Color="#B7D8D5" />

        <!-- New styles are intentionally scoped to LoginView for conflict-free review. -->
        <Style x:Key="LoginField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPasswordField" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="BusySpinner" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                 From="0" To="360" Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginButtonLabel" TargetType="TextBlock">
            <Setter Property="Text" Value="Đăng nhập" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Text" Value="Đang xác thực..." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Split layout: institutional branding on the left, focused sign-in form on the right. -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" MinWidth="360" />
            <ColumnDefinition Width="1.25*" MinWidth="470" />
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#081C2E" Offset="0" />
                    <GradientStop Color="#0C3F47" Offset="0.58" />
                    <GradientStop Color="#0F766E" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Ellipse Width="380" Height="380"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-210,-190,0"
                         Fill="#12FFFFFF" IsHitTestVisible="False" />
                <Ellipse Width="250" Height="250"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-140,0,0,-135"
                         Stroke="#225EEAD4" StrokeThickness="44"
                         IsHitTestVisible="False" />

                <Grid Margin="52,46,46,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="13" Background="#19FFFFFF">
                            <TextBlock Text="&#xE8D7;"
                                       Style="{StaticResource IconText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="21"
                                       Foreground="{StaticResource LoginMintBrush}" />
                        </Border>
                        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ExamTransfer"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource LoginHeroTextBrush}" />
                            <TextBlock Text="NỀN TẢNG THI CỬ NỘI BỘ"
                                       Margin="0,2,0,0" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource LoginMintBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="430">
                        <Border Width="44" Height="4" CornerRadius="2"
                                HorizontalAlignment="Center" Background="{StaticResource LoginMintBrush}"
                                Margin="0,0,0,22" />
                        <TextBlock Text="Một điểm truy cập.&#x0a;Mọi vai trò trong kỳ thi."
                                   FontSize="32" FontWeight="Bold" LineHeight="42"
                                   Foreground="{StaticResource LoginHeroTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Đăng nhập an toàn để quản lý phòng thi, phát đề và thu bài trong mạng nội bộ."
                                   Margin="0,16,0,28" MaxWidth="400"
                                   HorizontalAlignment="Left"
                                   FontSize="14" LineHeight="23"
                                   Foreground="{StaticResource LoginHeroMutedBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource LoginMintBrush}" />
                                </Border>
                                <TextBlock Text="Xác định vai trò tự động sau đăng nhập"
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{StaticResource LoginHeroTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource LoginMintBrush}" />
                                </Border>
                                <TextBlock Text="Vận hành ổn định trong mạng LAN"
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{StaticResource LoginHeroTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="7" Background="#16FFFFFF">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource LoginMintBrush}" />
                                </Border>
                                <TextBlock Text="Dữ liệu kỳ thi được bảo vệ trên thiết bị"
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{StaticResource LoginHeroTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hệ thống thu nộp bài kiểm tra"
                                   FontSize="10.5" Foreground="{StaticResource LoginHeroMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionLabel}"
                                   FontSize="10.5" Foreground="{StaticResource LoginHeroMutedBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Login form panel. ScrollViewer prevents clipping on short window sizes. -->
        <Grid Grid.Column="1">
            <Ellipse Width="310" Height="310"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-180,-155,0"
                     Fill="#090F766E" IsHitTestVisible="False" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid MinHeight="640" Margin="48,30">
                    <Border Style="{StaticResource Card}"
                            Width="440" MaxWidth="440"
                            Padding="38,34"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Effect="{StaticResource FloatingShadow}">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="14"
                                    HorizontalAlignment="Left" Margin="0,0,0,22">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0F766E" Offset="0" />
                                        <GradientStop Color="#0891B2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE8D7;"
                                           Style="{StaticResource IconText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="21"
                                           Foreground="White" />
                            </Border>

                            <TextBlock Text="Chào mừng trở lại"
                                       Style="{StaticResource DisplayTitleText}"
                                       FontSize="26" />
                            <TextBlock Text="Đăng nhập bằng tài khoản được nhà trường cấp."
                                       Style="{StaticResource BodyText}"
                                       Margin="0,7,0,26" FontSize="13.5" />

                            <TextBlock Text="Mã sinh viên hoặc email"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,7" />
                            <TextBox x:Name="AccountInput"
                                     Style="{StaticResource LoginField}"
                                     Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Ví dụ: 23174800110 hoặc admin@domain.com"
                                     AutomationProperties.Name="Mã sinh viên hoặc email"
                                     TabIndex="0" />
                            <TextBlock Text="Học sinh dùng mã sinh viên; giáo viên và quản trị viên dùng email."
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,6,0,18" TextWrapping="Wrap" />

                            <TextBlock Text="Mật khẩu"
                                       Style="{StaticResource LabelText}"
                                       Margin="0,0,0,7" />
                            <Grid>
                                <PasswordBox x:Name="PasswordInput"
                                             Style="{StaticResource LoginPasswordField}"
                                             PasswordChanged="OnPasswordChanged"
                                             AutomationProperties.Name="Mật khẩu"
                                             TabIndex="1"
                                             Padding="10,0,40,0" />
                                <TextBox x:Name="PasswordVisibleInput"
                                         Style="{StaticResource LoginField}"
                                         Visibility="Collapsed"
                                         TextChanged="OnVisiblePasswordChanged"
                                         TabIndex="1"
                                         Padding="10,0,40,0" />
                                <Button x:Name="TogglePasswordButton"
                                        Click="OnTogglePasswordClick"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Width="30" Height="30"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="Hiển thị mật khẩu">
                                    <TextBlock x:Name="TogglePasswordIcon" Text="&#xE890;" Style="{StaticResource IconText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" />
                                </Button>
                            </Grid>

                            <Button Command="{Binding LoginCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsDefault="True"
                                    Margin="0,24,0,0"
                                    MinHeight="48"
                                    FontSize="14"
                                    AutomationProperties.Name="Đăng nhập"
                                    TabIndex="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource BusySpinner}"
                                          Width="15" Height="15" Margin="0,0,9,0"
                                          Stroke="White" StrokeThickness="2"
                                          Data="M 7.5,0.8 A 6.7,6.7 0 1 1 2.8,2.8"
                                          Stretch="Uniform" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource LoginButtonLabel}"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Button>

                            <Border Margin="0,18,0,0"
                                    Padding="12,10" CornerRadius="8"
                                    BorderThickness="1"
                                    Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}, ConverterParameter=soft}"
                                    BorderBrush="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}"
                                               FontSize="14"
                                               Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                                               VerticalAlignment="Top" Margin="0,1,9,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Status}"
                                               Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                                               FontSize="12.5" LineHeight="19"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DeviceId, StringFormat=Thiết bị: {0}}"
                                           Style="{StaticResource CaptionText}"
                                           FontFamily="Consolas" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip="{Binding DeviceId}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
