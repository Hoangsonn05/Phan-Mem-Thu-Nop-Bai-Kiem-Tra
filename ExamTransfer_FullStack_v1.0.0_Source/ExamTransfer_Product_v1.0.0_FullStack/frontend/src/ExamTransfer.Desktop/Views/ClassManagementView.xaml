<UserControl x:Class="ExamTransfer.Desktop.Views.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             beh:EntranceAnimation.IsEnabled="True">
    <UserControl.Resources>
        <Style x:Key="ClassesCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="ClassesPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style x:Key="ClassesSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style x:Key="ClassesDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style x:Key="ClassesTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="ClassesLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- DataGridTextColumn creates its own TextBlock. Keep its selected text dark and crisp. -->
        <Style x:Key="ClassesGridText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
        <Style x:Key="ClassesGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="RowHeight" Value="52" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="16,11" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <!-- Keep selected-row content readable; WPF otherwise applies a white system selection foreground. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClassesStudentGrid" TargetType="DataGrid" BasedOn="{StaticResource ClassesGrid}">
            <Setter Property="RowHeight" Value="48" />
        </Style>
    </UserControl.Resources>

        <Grid Margin="32,24,32,20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page heading and commands retain their existing bindings. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel MaxWidth="720">
                <TextBlock Text="Quản lý lớp và học sinh"
                           FontSize="28"
                           FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Tạo lớp, cập nhật hồ sơ, quản lý học sinh và import danh sách có kiểm tra trước khi ghi dữ liệu."
                           Margin="0,6,0,0"
                           FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                    <Border Width="60" Height="3" Margin="0,13,0,0" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" />
            </StackPanel>
             <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource ClassesSecondaryButton}" />
                <Button Content="Xuất CSV" Command="{Binding ExportCommand}" Style="{StaticResource ClassesSecondaryButton}" Margin="8,0,0,0" />
                <Button Content="Import CSV" Command="{Binding ImportCommand}" Style="{StaticResource ClassesSecondaryButton}" Margin="8,0,0,0" />
                <Button Content="+  Tạo lớp" Command="{Binding CreateCommand}" Style="{StaticResource ClassesPrimaryButton}" Margin="8,0,0,0" />
             </WrapPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.22*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Class list -->
            <Border Grid.Column="0" Style="{StaticResource ClassesCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,17,20,14">
                        <StackPanel>
                            <TextBlock Text="Danh sách lớp" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Chọn một lớp để xem và quản lý thông tin chi tiết." Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Content="Mở chi tiết" Command="{Binding OpenCommand}" Style="{StaticResource ClassesSecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="34" Padding="12,6" />
                    </Grid>
                    <DataGrid Grid.Row="1" Style="{StaticResource ClassesGrid}" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" Margin="0,0,0,4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ LỚP" Binding="{Binding Code}" Width="110" FontWeight="SemiBold" ElementStyle="{StaticResource ClassesGridText}" />
                            <DataGridTextColumn Header="TÊN LỚP" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource ClassesGridText}" />
                            <DataGridTextColumn Header="NĂM HỌC" Binding="{Binding SchoolYear}" Width="120" ElementStyle="{StaticResource ClassesGridText}" />
                            <DataGridTextColumn Header="HỌC SINH" Binding="{Binding StudentCount}" Width="90" ElementStyle="{StaticResource ClassesGridText}" />
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="116">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" Padding="9,4" CornerRadius="12" Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active"><Setter Property="Foreground" Value="{DynamicResource SuccessOnSoftBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detail and student management -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource ClassesCard}">
                        <StackPanel>
                            <TextBlock Text="Thông tin lớp" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Cập nhật thông tin và năm học của lớp đang chọn." Margin="0,3,0,14" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <Separator Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="Tên lớp *" Style="{StaticResource ClassesLabel}" Margin="0,16,0,6" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ClassesTextBox}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mã lớp *" Style="{StaticResource ClassesLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Code}" Style="{StaticResource ClassesTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Năm học" Style="{StaticResource ClassesLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding SchoolYear}" Style="{StaticResource ClassesTextBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mô tả" Style="{StaticResource ClassesLabel}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Description}" Style="{StaticResource ClassesTextBox}" Height="80" MinHeight="80" Padding="12,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                            <TextBlock Text="Phạm vi truy cập" Style="{StaticResource ClassesLabel}" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding AccessModes}"
                                      SelectedItem="{Binding AccessMode}" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="Lưu thay đổi" Command="{Binding SaveClassCommand}" Style="{StaticResource ClassesPrimaryButton}" />
                                <Button Content="Lưu trữ lớp" Command="{Binding ArchiveCommand}" Style="{StaticResource ClassesDangerButton}" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClassesCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Thêm hoặc cập nhật học sinh" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Chọn học sinh trong bảng để chỉnh sửa hoặc xóa." Margin="0,3,0,14" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <Separator Background="{DynamicResource BorderBrush}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mã học sinh *" Style="{StaticResource ClassesLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding StudentCode}" Style="{StaticResource ClassesTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Họ tên *" Style="{StaticResource ClassesLabel}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding StudentName}" Style="{StaticResource ClassesTextBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Email" Style="{StaticResource ClassesLabel}" Margin="0,14,0,6" />
                            <TextBox Text="{Binding StudentEmail}" Style="{StaticResource ClassesTextBox}" />
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Content="+  Thêm mới" Command="{Binding AddStudentCommand}" Style="{StaticResource ClassesPrimaryButton}" />
                                <Button Content="Cập nhật" Command="{Binding UpdateStudentCommand}" Style="{StaticResource ClassesSecondaryButton}" Margin="10,0,0,0" />
                                <Button Content="Xóa khỏi lớp" Command="{Binding RemoveStudentCommand}" Style="{StaticResource ClassesDangerButton}" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ClassesCard}" Margin="0,16,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="190" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="20,17,20,14">
                                <TextBlock Text="Yêu cầu ghi danh Public Cloud"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Duyệt hoặc từ chối học sinh xin tham gia lớp."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      Style="{StaticResource ClassesStudentGrid}"
                                      ItemsSource="{Binding EnrollmentRequests}"
                                      SelectedItem="{Binding SelectedEnrollmentRequest}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ HỌC SINH" Binding="{Binding StudentCode}" Width="*" />
                                    <DataGridTextColumn Header="TRẠNG THÁI" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="YÊU CẦU LÚC" Binding="{Binding RequestedAtUtc}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,12,20,16">
                                <Button Content="Duyệt"
                                        Command="{Binding ApproveEnrollmentCommand}"
                                        Style="{StaticResource ClassesPrimaryButton}" />
                                <Button Content="Từ chối"
                                        Command="{Binding RejectEnrollmentCommand}"
                                        Style="{StaticResource ClassesDangerButton}"
                                        Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ClassesCard}" Margin="0,16,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /></Grid.RowDefinitions>
                            <Grid Margin="20,17,20,14">
                                <StackPanel>
                                    <TextBlock Text="Học sinh trong lớp" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="Chọn một dòng để cập nhật thông tin học sinh." Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}">
                                    <TextBlock Text="{Binding Students.Count, StringFormat={}{0} học sinh}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
                                </Border>
                            </Grid>
                            <DataGrid Grid.Row="1" Style="{StaticResource ClassesStudentGrid}" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MÃ" Binding="{Binding StudentCode}" Width="110" FontWeight="SemiBold" ElementStyle="{StaticResource ClassesGridText}" />
                                    <DataGridTextColumn Header="HỌ TÊN" Binding="{Binding DisplayName}" Width="*" ElementStyle="{StaticResource ClassesGridText}" />
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*" ElementStyle="{StaticResource ClassesGridText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ProductPageBase exposes Status/StatusTone; there is no separate ErrorMessage binding. -->
        <Border Grid.Row="4" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="20" CornerRadius="2" Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}" FontSize="13" Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
