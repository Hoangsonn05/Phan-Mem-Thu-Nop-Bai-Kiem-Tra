<UserControl x:Class="ExamTransfer.Desktop.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Cài đặt" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="Thông tin vận hành và các tùy chọn an toàn dành cho giáo viên."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Làm mới"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButton}"
                    MinHeight="44"
                    Padding="18,0" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="960" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Trạng thái hệ thống" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Kết nối" Style="{StaticResource CaptionText}" Margin="0,18,0,4" />
                            <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="Dung lượng lưu trữ" Style="{StaticResource CaptionText}" Margin="0,16,0,4" />
                            <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Phiên bản ứng dụng" Style="{StaticResource CaptionText}" Margin="0,16,0,4" />
                            <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Cảnh báo" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding WarningSummary}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Đồng bộ dữ liệu" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding SynchronizationStatus}"
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                            <Button Content="Đồng bộ lại"
                                    Command="{Binding SyncCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    MinHeight="44"
                                    HorizontalAlignment="Left"
                                    Margin="0,18,0,0"
                                    Padding="20,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Hỗ trợ" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Mở thư mục hỗ trợ khi cần gửi thông tin lỗi cho quản trị viên."
                                       Style="{StaticResource BodyText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />
                            <Button Content="Mở thư mục hỗ trợ"
                                    Command="{Binding OpenSupportFolderCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinHeight="44"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,0"
                                    Padding="20,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="4"
                Padding="12,10"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource SurfaceSubtleBrush}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3"
                        Height="20"
                        CornerRadius="2"
                        Background="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                        Margin="0,0,10,0" />
                <TextBlock Text="{Binding Status}"
                           Foreground="{Binding StatusTone, Converter={StaticResource ToneBrushConverter}}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
