<UserControl x:Class="ExamTransfer.Desktop.Views.StudentConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:ExamTransfer.Desktop.Behaviors"
             beh:EntranceAnimation.IsEnabled="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32" MaxWidth="1180" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" MaxWidth="760">
                <Border Width="58" Height="58" CornerRadius="18"
                        Background="{DynamicResource PrimarySoftBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE968;" Style="{StaticResource IconText}" FontSize="25"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>
                <TextBlock Text="Tham gia kỳ thi" Style="{StaticResource DisplayTitleText}"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Chọn kỳ thi đang chờ trong LAN hoặc tham gia PublicCloud bằng mã phòng."
                           Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,7,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <RadioButton Content="Trong mạng LAN"
                                 GroupName="ConnectionMode"
                                 IsChecked="{Binding IsLanMode, Mode=TwoWay}"/>
                    <RadioButton Content="PublicCloud"
                                 GroupName="ConnectionMode"
                                 IsChecked="{Binding IsPublicCloudMode, Mode=TwoWay}"
                                 Margin="24,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="20,18,20,12">
                            <StackPanel>
                                <TextBlock Text="Kỳ thi đang chờ trong LAN" Style="{StaticResource SectionTitleText}"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Command="{Binding ScanCommand}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding IsLanMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="15"/>
                                    <TextBlock Text="Quét lại" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding Rooms}"
                                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="12,0,12,8"
                                     Visibility="{Binding IsLanMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Root" Padding="15" CornerRadius="11"
                                                            Background="{DynamicResource SurfaceSubtleBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Root" Property="Background"
                                                                    Value="{DynamicResource PrimarySoftBrush}"/>
                                                            <Setter TargetName="Root" Property="BorderBrush"
                                                                    Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ExamTitle}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding Subject}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
                                                <WrapPanel Margin="0,7,0,0">
                                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text=" · " Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="{Binding DeliveryText}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text=" · " Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="{Binding TeacherName}" Style="{StaticResource CaptionText}"/>
                                                </WrapPanel>
                                                <WrapPanel Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding ApprovalText}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text=" · " Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="{Binding CapacityText}" Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text=" · " Style="{StaticResource CaptionText}"/>
                                                    <TextBlock Text="{Binding StartText}" Style="{StaticResource CaptionText}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                                                <Border Style="{StaticResource StatusPill}"
                                                        Background="{DynamicResource SuccessSoftBrush}">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding RoomCode}" Style="{StaticResource CaptionText}"
                                                           FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource SubtleCard}" Margin="20,8"
                                    Visibility="{Binding HasNoRooms, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Chưa tìm thấy kỳ thi LanOnly đang chờ."
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Hãy quét lại hoặc mở Kết nối thủ công (nâng cao)."
                                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SubtleCard}" Margin="20,8"
                                    Visibility="{Binding IsPublicCloudMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Tham gia PublicCloud" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nhập mã phòng ở panel bên phải. Danh sách phòng không được công khai."
                                               Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0" Padding="20,15">
                            <TextBlock Text="Chọn một kỳ thi đang chờ để xem thông tin và gửi yêu cầu tham gia."
                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Thông tin kỳ thi và tham gia" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="Thông tin tài khoản được lấy từ phiên đăng nhập hiện tại."
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Họ tên" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding DisplayName}" IsReadOnly="True" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mã sinh viên" Style="{StaticResource LabelText}"/>
                                <TextBox Text="{Binding StudentCode}" IsReadOnly="True" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsLanMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Tên bài" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding SelectedRoom.ExamTitle}" IsReadOnly="True" Margin="0,6,0,0"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Môn học" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.Subject}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Thời lượng" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.DurationText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giáo viên" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.TeacherName}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Trạng thái" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.StatusText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Chế độ" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.DeliveryText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duyệt tham gia" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.ApprovalText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Giờ dự kiến" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.StartText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số lượng" Style="{StaticResource LabelText}"/>
                                    <TextBox Text="{Binding SelectedRoom.CapacityText}" IsReadOnly="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Mã phòng" Style="{StaticResource LabelText}" Margin="0,12,0,0"/>
                            <TextBox Text="{Binding RoomCode}" IsReadOnly="True"
                                     Margin="0,6,0,0" FontFamily="Consolas"/>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsPublicCloudMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Mã phòng" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,0" CharacterCasing="Upper"/>
                            <TextBlock Text="PublicCloud OpenRequest không yêu cầu mã lớp hoặc ghi danh lớp."
                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Command="{Binding JoinCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="0,24,0,0" Height="46" FontSize="16"
                                AutomationProperties.Name="Yêu cầu tham gia kỳ thi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Margin="0,0,8,0" FontSize="18"/>
                                <TextBlock Text="Yêu cầu tham gia"/>
                            </StackPanel>
                        </Button>

                        <Expander Header="Kết nối thủ công (nâng cao)" Margin="0,18,0,0"
                                  Visibility="{Binding IsLanMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Chỉ dùng khi kỳ thi không xuất hiện trong danh sách LAN."
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                <TextBlock Text="Địa chỉ IP" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                                <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Cổng" Style="{StaticResource LabelText}"/>
                                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Mã phòng" Style="{StaticResource LabelText}"/>
                                        <TextBox Text="{Binding RoomCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0" CharacterCasing="Upper"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Máy chủ chẩn đoán" Style="{StaticResource LabelText}" Margin="0,12,0,6"/>
                                <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                          DisplayMemberPath="Address"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,20,0,4" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="20">
                        <TextBlock Text="Kiểm tra sẵn sàng" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="Thiết bị đáp ứng điều kiện cơ bản trước khi tham gia."
                                   Style="{StaticResource CaptionText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Readiness}" Margin="0,14,16,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SubtleCard}" Margin="0,0,8,0" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="14"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="7,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
